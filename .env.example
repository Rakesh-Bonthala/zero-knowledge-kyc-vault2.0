# Server Configuration
PORT=3000
NODE_ENV=development

# Storage Provider: 'gridfs' | 's3' | 'firebase' | 'mock'
STORAGE_PROVIDER=gridfs

# Fallback to mock storage if primary provider connection fails (true/false)
STORAGE_ALLOW_MOCK_FALLBACK=true

# MongoDB GridFS Configuration (Primary Option)
# Example: mongodb://localhost:27017/zk_kyc_vault or MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/zk_kyc_vault

# Optional: AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=zk-kyc-vault-bucket

# Optional: Firebase Storage Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Security & Session Secrets (Replace with cryptographically secure random values)
SESSION_SECRET=replace_with_a_long_cryptographically_secure_random_session_secret
OTP_SECRET=replace_with_a_long_cryptographically_secure_random_otp_secret
CSRF_SECRET=replace_with_a_long_cryptographically_secure_random_csrf_secret

# Optional: SMTP Email Transport (Defaults to automated Ethereal test inbox in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@zeroknowledgevault.com

# Security Constraints
MAX_FILE_SIZE_MB=50
CORS_ORIGIN=http://localhost:3000
